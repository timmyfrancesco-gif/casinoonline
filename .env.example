# Copia in .env e adatta. Le variabili sono lette da apps/server (dev, start, db:migrate).
# I test non leggono questo file: esporta TEST_DATABASE_URL ed E2E_* nella shell (README, Test).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casino_dev
PORT=3000
HOST=0.0.0.0
# Origini consentite (CSRF), separate da virgola: Vite dev (5173) e vite preview (4173).
APP_ORIGIN=http://localhost:5173,http://localhost:4173
NODE_ENV=development
# In produzione: true (cookie solo su HTTPS)
COOKIE_SECURE=false
# Percorso della build del web servita dal server (produzione), es. ../web/dist
# SERVE_WEB_DIST=
# Dietro un reverse proxy: numero di proxy davanti al server (di solito 1) o elenco di IP/CIDR
# fidati. Evita true: il client può falsificare X-Forwarded-For e aggirare il rate limit.
# Vedi README (Deploy in produzione).
TRUST_PROXY=false

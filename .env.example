# Copia in .env e adatta. Le variabili sono lette da apps/server.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casino_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/casino_test
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# In produzione: true (cookie solo su HTTPS)
COOKIE_SECURE=false
# Percorso della build del web servita dal server (produzione), es. ../web/dist
# SERVE_WEB_DIST=
# true se il server sta dietro un reverse proxy (X-Forwarded-For)
TRUST_PROXY=false
